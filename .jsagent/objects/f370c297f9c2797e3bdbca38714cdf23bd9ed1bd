package com.polymath.fs.models;

import java.util.Stack;

public class TabState {
    private String tabId;
    private String name;
    private Stack<String> pathHistory;

    public TabState(String tabId, String name) {
        this.tabId = tabId;
        this.name = name;
        this.pathHistory = new Stack<>();
    }

    public String getTabId() {
        return tabId;
    }

    public void setTabId(String tabId) {
        this.tabId = tabId;
    }

    public String getName() {
        return name;
    }

    public void setName(String name) {
        this.name = name;
    }

    public Stack<String> getPathHistory() {
        return pathHistory;
    }

    public void setPathHistory(Stack<String> pathHistory) {
        this.pathHistory = pathHistory;
    }
}
