function applyDayMode() {
    var customTheme = {
        name: "Light Minimal",
        primaryBg: "#ffffff",
        secondaryBg: "#f1f5f9",
        textColor: "#0f172a",
        accentColor: "#2563eb"
    };
    PolymathOS.setTheme(JSON.stringify(customTheme));
    PolymathOS.toast("Theme Activated: Light Minimal");
}