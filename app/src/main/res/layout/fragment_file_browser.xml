<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurfaceVariant"
        app:titleTextColor="#ffffff"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceVariant"
        app:tabTextColor="#94a3b8"
        app:tabSelectedTextColor="#ffffff"
        app:tabIndicatorColor="#38bdf8"
        app:tabMode="scrollable"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/addressBarContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayout">

        <TextView
            android:id="@+id/pathText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="12dp"
            android:textColor="#94a3b8"
            android:textSize="14sp"
            android:ellipsize="middle"
            android:singleLine="true"
            tools:text="/storage/emulated/0/Download/SomeFolder" />

        <ImageButton
            android:id="@+id/copyPathButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Copy Path"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="#94a3b8" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/recentFilesPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="?attr/colorSurfaceVariant"
        app:layout_constraintTop_toBottomOf="@id/addressBarContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Recent Files"
                android:textColor="#ffffff"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/btnViewMoreRecents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View more"
                android:textColor="#38bdf8"
                android:textSize="14sp"
                android:background="?attr/selectableItemBackground" />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recentRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingBottom="16dp" />
    </LinearLayout>

    <!-- The Architect's Workbench Pane -->
    <FrameLayout
        android:id="@+id/workbench_container"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:layout_margin="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/recentFilesPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#1e293b"
            app:strokeColor="#38bdf8"
            app:strokeWidth="1dp">

            <WebView
                android:id="@+id/workbench_webview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />
                
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingVertical="8dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/omniTerminalContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/workbench_container"
        tools:listitem="@layout/item_file" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/emptyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Folder is empty"
        android:textColor="#94a3b8"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/omniTerminalContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0f172a"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1e293b"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JS ENGINE STATUS"
                android:textColor="#94a3b8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_weight="1" />
                
            <TextView
                android:id="@+id/cpuMetricText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CPU: 0%"
                android:textColor="#38bdf8"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:layout_marginEnd="8dp" />
                
            <TextView
                android:id="@+id/memMetricText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MEM: 0MB"
                android:textColor="#10b981"
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </LinearLayout>
        
        <ScrollView
            android:id="@+id/terminalConsoleScroll"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:visibility="gone"
            android:background="#0f172a"
            android:padding="8dp">
            <TextView
                android:id="@+id/terminalConsoleOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#38bdf8"
                android:textSize="12sp"
                android:fontFamily="monospace" />
        </ScrollView>
            
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=">"
                android:textColor="#38bdf8"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingEnd="8dp" />
                
            <EditText
                android:id="@+id/omniTerminalInput"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@null"
                android:hint="Type a JS command or action..."
                android:textColorHint="#475569"
                android:textColor="#e2e8f0"
                android:textSize="14sp"
                android:inputType="textNoSuggestions"
                android:imeOptions="actionSend"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
