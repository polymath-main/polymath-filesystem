<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0f172a">

    <!-- Top AppBar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1e293b"
        app:title="TextEditor"
        app:titleTextColor="#f8fafc"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:navigationIconTint="#f8fafc" />

    <!-- Code Quick Accessory Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="#1e293b"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/accessory_bar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/btn_sym_tab"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Tab"
                android:textColor="#38bdf8"
                android:textStyle="bold"
                android:textSize="12sp"
                android:background="?android:attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btn_sym_brace_open"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="{"
                android:textColor="#f8fafc"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="?android:attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btn_sym_brace_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="}"
                android:textColor="#f8fafc"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="?android:attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btn_sym_paren_open"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="("
                android:textColor="#f8fafc"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="?android:attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btn_sym_paren_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text=")"
                android:textColor="#f8fafc"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="?android:attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btn_sym_bracket_open"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="["
                android:textColor="#f8fafc"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="?android:attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btn_sym_bracket_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="]"
                android:textColor="#f8fafc"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="?android:attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btn_sym_semi"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text=";"
                android:textColor="#f8fafc"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="?android:attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btn_sym_equal"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="="
                android:textColor="#f8fafc"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="?android:attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btn_sym_quote"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="&quot;"
                android:textColor="#f8fafc"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="?android:attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btn_sym_squote"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="'"
                android:textColor="#f8fafc"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="?android:attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btn_sym_slash"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="/"
                android:textColor="#f8fafc"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="?android:attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btn_sym_dollar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="$"
                android:textColor="#f8fafc"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="?android:attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btn_sym_dot"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="."
                android:textColor="#f8fafc"
                android:textStyle="bold"
                android:textSize="15sp"
                android:background="?android:attr/selectableItemBackground" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Editor Main Area (Line numbers + Code EditText) -->
    <LinearLayout
        android:id="@+id/editor_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Line Numbers Column -->
        <ScrollView
            android:id="@+id/scroll_line_numbers"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:background="#0b1120"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tv_line_numbers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:paddingEnd="6dp"
                android:paddingTop="12dp"
                android:textColor="#475569"
                android:textSize="13sp"
                android:fontFamily="monospace"
                android:lineSpacingMultiplier="1.2"
                android:text="1\n2\n3\n4\n5" />
        </ScrollView>

        <!-- Code Input -->
        <ScrollView
            android:id="@+id/scroll_editor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fillViewport="true">

            <HorizontalScrollView
                android:id="@+id/hscroll_editor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true">

                <EditText
                    android:id="@+id/et_code"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="600dp"
                    android:background="@null"
                    android:fontFamily="monospace"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:lineSpacingMultiplier="1.2"
                    android:padding="12dp"
                    android:textColor="#f8fafc"
                    android:textSize="13sp" />
            </HorizontalScrollView>
        </ScrollView>
    </LinearLayout>

    <!-- Real-time Console Output Drawer -->
    <LinearLayout
        android:id="@+id/console_panel"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="#090d16"
        android:orientation="vertical">

        <!-- Console Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="#161f30"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Console Output"
                android:textColor="#38bdf8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_console_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="#334155"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="0 logs"
                android:textColor="#94a3b8"
                android:textSize="10sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_console_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="Clear"
                android:textColor="#94a3b8"
                android:textSize="11sp"
                android:background="?android:attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btn_console_copy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:padding="6dp"
                android:text="Copy"
                android:textColor="#94a3b8"
                android:textSize="11sp"
                android:background="?android:attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btn_console_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:padding="6dp"
                android:text="▼"
                android:textColor="#38bdf8"
                android:textSize="11sp"
                android:background="?android:attr/selectableItemBackground" />
        </LinearLayout>

        <!-- Console Scroll Area -->
        <ScrollView
            android:id="@+id/scroll_console"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="8dp">

            <TextView
                android:id="@+id/tv_console_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#e2e8f0"
                android:textSize="11sp"
                android:text="Ready. Tap '▶ Run' to execute script." />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
