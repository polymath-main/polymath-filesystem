<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="#0A0F1D">

    <!-- Primary Interactive Cognitive Canvas Surface -->
    <com.polymath.fs.ui.canvas.CognitiveCanvasView
        android:id="@+id/cognitiveCanvasView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Glassmorphic Header Card with System Bar Padding -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/headerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="#CC0F172A"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:strokeColor="#3338BDF8"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <!-- Header Action Row: Navigation & Primary Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Back"
                    android:src="@android:drawable/ic_menu_revert"
                    app:tint="#FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCanvasTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cognitive Canvas"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCanvasSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:text="Spatial File Relationship Engine"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Undo Action Button -->
                <ImageButton
                    android:id="@+id/btnUndo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="2dp"
                    android:alpha="0.4"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Undo Canvas Action"
                    android:src="@drawable/ic_undo"
                    app:tint="#E2E8F0" />

                <!-- Redo Action Button -->
                <ImageButton
                    android:id="@+id/btnRedo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="2dp"
                    android:alpha="0.4"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Redo Canvas Action"
                    android:src="@drawable/ic_redo"
                    app:tint="#E2E8F0" />

                <!-- Search Toggle Button -->
                <ImageButton
                    android:id="@+id/btnSearchToggle"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Search Canvas Files"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#94A3B8" />

            </LinearLayout>

            <!-- Horizontal Tool Ribbon: Heatmap, ML Auto-Grouping, Presets, Snapshots & Canvas Controls -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fadingEdge="horizontal"
                android:fadingEdgeLength="16dp"
                android:requiresFadingEdge="horizontal"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Activity Heatmap Toggle -->
                    <LinearLayout
                        android:id="@+id/btnHeatmap"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_canvas_tool_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:id="@+id/ivHeatmapIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Activity Heatmap"
                            android:src="@drawable/ic_flame_heatmap"
                            app:tint="#FF2A6D" />

                        <TextView
                            android:id="@+id/tvHeatmapText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Heatmap"
                            android:textColor="#E2E8F0"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- ML Auto-Grouping Suggestions -->
                    <LinearLayout
                        android:id="@+id/btnMLSuggest"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_canvas_tool_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="ML Grouping"
                            android:src="@drawable/ic_auto_awesome"
                            app:tint="#C084FC" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="ML Group"
                            android:textColor="#E2E8F0"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Spatial Canvas Presets -->
                    <LinearLayout
                        android:id="@+id/btnPresets"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_canvas_tool_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Canvas Presets"
                            android:src="@drawable/ic_canvas_presets"
                            app:tint="#38BDF8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Presets"
                            android:textColor="#E2E8F0"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Workspace Snapshots (Timestamp Recovery) -->
                    <LinearLayout
                        android:id="@+id/btnSnapshots"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_canvas_tool_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Workspace Snapshots"
                            android:src="@drawable/ic_workspace_snapshot"
                            app:tint="#34D399" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Snapshots"
                            android:textColor="#E2E8F0"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Snap to Grid Toggle Button -->
                    <LinearLayout
                        android:id="@+id/btnSnapToGrid"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_canvas_tool_pill_active"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:id="@+id/ivSnapIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Toggle Snap to Grid"
                            android:src="@android:drawable/ic_menu_sort_by_size"
                            app:tint="#38BDF8" />

                        <TextView
                            android:id="@+id/tvSnapText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Snap Grid"
                            android:textColor="#38BDF8"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Visual Grid Overlay Toggle Button -->
                    <LinearLayout
                        android:id="@+id/btnVisualGrid"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_canvas_tool_pill_active"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:id="@+id/ivGridLinesIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Toggle Visual Grid Lines"
                            android:src="@drawable/ic_grid_on"
                            app:tint="#38BDF8" />

                        <TextView
                            android:id="@+id/tvGridLinesText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Grid Lines"
                            android:textColor="#38BDF8"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Smart Arrange Button -->
                    <LinearLayout
                        android:id="@+id/btnSmartArrange"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_canvas_tool_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Smart Arrange Clustered Graph"
                            android:src="@android:drawable/ic_menu_rotate"
                            app:tint="#38BDF8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Arrange"
                            android:textColor="#E2E8F0"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Export Layout as Image Button -->
                    <LinearLayout
                        android:id="@+id/btnExportImage"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_canvas_tool_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Export Canvas as Image"
                            android:src="@drawable/ic_export_image"
                            app:tint="#38BDF8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Export"
                            android:textColor="#E2E8F0"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Link Mode Toggle -->
                    <LinearLayout
                        android:id="@+id/btnLinkMode"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_canvas_tool_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:id="@+id/ivLinkIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Draw Link"
                            android:src="@android:drawable/ic_menu_share"
                            app:tint="#94A3B8" />

                        <TextView
                            android:id="@+id/tvLinkText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Draw Link"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Reset Camera / Center -->
                    <LinearLayout
                        android:id="@+id/btnResetView"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_canvas_tool_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Center View"
                            android:src="@android:drawable/ic_menu_compass"
                            app:tint="#94A3B8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Center"
                            android:textColor="#E2E8F0"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Help / Guide -->
                    <LinearLayout
                        android:id="@+id/btnHelp"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_canvas_tool_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Show Gesture Guide"
                            android:src="@android:drawable/ic_menu_help"
                            app:tint="#94A3B8" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Guide"
                            android:textColor="#E2E8F0"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Search Bar Row (Top of CognitiveCanvas view) -->
            <LinearLayout
                android:id="@+id/layoutSearchBar"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_canvas_search_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Search Icon"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#38BDF8" />

                <EditText
                    android:id="@+id/etCanvasSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Search files by name, extension..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSearchResultCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text=""
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="1/4"
                    tools:visibility="visible" />

                <ImageButton
                    android:id="@+id/btnSearchPrev"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Previous Result"
                    android:src="@android:drawable/arrow_up_float"
                    android:visibility="gone"
                    app:tint="#94A3B8"
                    tools:visibility="visible" />

                <ImageButton
                    android:id="@+id/btnSearchNext"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Next Result"
                    android:src="@android:drawable/arrow_down_float"
                    android:visibility="gone"
                    app:tint="#94A3B8"
                    tools:visibility="visible" />

                <ImageButton
                    android:id="@+id/btnClearSearch"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Clear Search"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:visibility="gone"
                    app:tint="#94A3B8"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating Scale Slider Pill (Precision Zoom Control & Indicator) -->
    <LinearLayout
        android:id="@+id/floatingScalePill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="68dp"
        android:background="@drawable/bg_zoom_slider_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/btnZoomOut"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="-"
            android:textColor="#38BDF8"
            android:textSize="18sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekBarZoom"
            android:layout_width="140dp"
            android:layout_height="wrap_content"
            android:max="380"
            android:progress="80"
            android:progressTint="#38BDF8"
            android:thumbTint="#38BDF8" />

        <TextView
            android:id="@+id/btnZoomIn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="+"
            android:textColor="#38BDF8"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvZoomPercent"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:gravity="end"
            android:text="100%"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Status Pill -->
    <LinearLayout
        android:id="@+id/bottomStatusPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="#CC0F172A"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tvStatusHelp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 Long-press any file for Quick Actions (Color-Code, Rename, Move, Delete)"
            android:textColor="#E2E8F0"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Interactive Coach-mark Overlay for First Launch Guidance -->
    <FrameLayout
        android:id="@+id/coachMarkOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#DD070B14"
        android:clickable="true"
        android:focusable="true"
        android:padding="20dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_coachmark_card"
            android:orientation="vertical"
            android:padding="22dp">

            <!-- Header Badge & Title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Cognitive Canvas Icon"
                    android:src="@android:drawable/ic_menu_compass"
                    app:tint="#38BDF8" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Cognitive Canvas Guide"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Master fluid spatial navigation and file clustering gestures"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="#2038BDF8" />

            <!-- Guide Item 1: Panning -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="🖐️"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pan Canvas Viewport"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Drag anywhere on empty space to navigate your file universe"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Guide Item 2: Pinch to Zoom -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pinch to Zoom"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pinch with two fingers to zoom from micro file details to macro overview"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Guide Item 3: Snap to Grid Drag & Drop -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="🎯"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Snap-to-Grid Drag &amp; Drop"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Drag files with haptic feedback to align perfectly to invisible coordinate grids"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Guide Item 4: Long-Press & Color Code -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="🎨"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Long-Press &amp; Theme Color"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Long-press any node to color-code files, rename, move, pin, or delete"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Guide Item 5: Smart Arrange & Search -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="🪄"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Smart Arrange &amp; Search"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto-organize files by metadata and search to highlight and center instantly"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Dismiss Button -->
            <Button
                android:id="@+id/btnDismissCoachMark"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_canvas_btn_primary"
                android:text="Got It! Start Exploring"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>
    </FrameLayout>

    <!-- Expandable Bottom Sheet Preview Panel for Selected File Nodes -->
    <include
        android:id="@+id/previewPanel"
        layout="@layout/layout_canvas_preview_panel" />

    <!-- Quick Actions Overlay (Drag and Drop) -->
    <LinearLayout
        android:id="@+id/quickActionsOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="100dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        android:padding="16dp"
        android:background="#88000000"
        android:elevation="20dp"
        tools:visibility="visible">

        <TextView
            android:id="@+id/dropZoneMove"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="16dp"
            android:background="@drawable/bg_coachmark_card"
            android:gravity="center"
            android:text="MOVE"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/dropZoneCopy"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="16dp"
            android:background="@drawable/bg_coachmark_card"
            android:gravity="center"
            android:text="COPY"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/dropZoneDelete"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_margin="16dp"
            android:background="@drawable/bg_coachmark_card"
            android:gravity="center"
            android:text="DELETE"
            android:textColor="#FF5252" />
    </LinearLayout>

    <!-- Auto-generating File Preview Peek (Long Press) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/filePreviewPeekOverlay"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:visibility="gone"
        app:cardBackgroundColor="#CC0F172A"
        app:cardCornerRadius="16dp"
        app:cardElevation="20dp"
        app:strokeColor="#38BDF8"
        app:strokeWidth="1dp"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/ivOverlayThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
            
        <TextView
            android:id="@+id/tvOverlaySnippet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:visibility="gone" />
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
