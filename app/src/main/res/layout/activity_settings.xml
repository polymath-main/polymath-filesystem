<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Theme"
        android:textSize="18sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/rbCyberpunk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cyberpunk" />

        <RadioButton
            android:id="@+id/rbOceanBreeze"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ocean Breeze" />

        <RadioButton
            android:id="@+id/rbDracula"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dracula" />

        <RadioButton
            android:id="@+id/rbSolarizedDark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Solarized Dark" />

        <RadioButton
            android:id="@+id/rbSunset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sunset" />

        <RadioButton
            android:id="@+id/rbHackerGreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hacker Green" />

        <RadioButton
            android:id="@+id/rbNeon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Neon" />

        <RadioButton
            android:id="@+id/rbMaterialYou"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Material You" />

        <RadioButton
            android:id="@+id/rbIosLike"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="iOS-like" />

        <RadioButton
            android:id="@+id/rbTrueAmoled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="True AMOLED" />
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#ccc" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Primary Color"
        android:textSize="18sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgPrimaryColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/rbColorBlue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blue (Default)" />

        <RadioButton
            android:id="@+id/rbColorGreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Green" />

        <RadioButton
            android:id="@+id/rbColorPurple"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Purple" />
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#ccc" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Icon Pack"
        android:textSize="18sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgIconPack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/rbIconDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Default (Filled)" />

        <RadioButton
            android:id="@+id/rbIconOutline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Outline" />
            
        <RadioButton
            android:id="@+id/rbIconMinimal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minimal" />
    </RadioGroup>

</LinearLayout>
