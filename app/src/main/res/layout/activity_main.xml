<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#0f172a">

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">

        <!-- 1. File System View -->
        <LinearLayout
            android:id="@+id/mainContainer" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical">

            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:background="#1e293b">
                <LinearLayout android:id="@+id/tabsContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="8dp" />
            </HorizontalScrollView>
            
            <!-- Bookmark Quick Action Bar -->
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:background="#334155">
                <LinearLayout android:id="@+id/bookmarksContainer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="4dp" />
            </HorizontalScrollView>

            <LinearLayout android:id="@+id/headerContainer" android:layout_width="match_parent" android:layout_height="60dp"
                android:orientation="horizontal" android:background="#1e293b" android:padding="16dp" android:gravity="center_vertical">
                <TextView android:id="@+id/pathText" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:textColor="#f8fafc" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="start" />
                <EditText android:id="@+id/searchInput" android:layout_width="120dp" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:textColor="#f8fafc" android:textSize="14sp" android:hint="Search..." android:textColorHint="#64748b" android:background="@null" android:singleLine="true" android:imeOptions="actionSearch" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView android:id="@+id/fileRecyclerView" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1" />
        </LinearLayout>

        <!-- 2. JS Engine Dashboard View -->
        <LinearLayout
            android:id="@+id/dashboardContainer" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:visibility="gone">

            <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"
                android:orientation="horizontal" android:background="#1e293b" android:padding="16dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:textColor="#f8fafc" android:textSize="18sp" android:textStyle="bold" android:text="JS Engine Dashboard" />
                <TextView android:id="@+id/btnNewScript" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="#3b82f6" android:textSize="14sp" android:textStyle="bold" android:text="+ NEW SCRIPT" android:padding="8dp" />
            </LinearLayout>
            
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#94a3b8" android:textSize="12sp" android:text="PolymathExtensions/ (Modular Scripts)" android:paddingHorizontal="16dp" android:paddingVertical="8dp" android:background="#0f172a" />

            <androidx.recyclerview.widget.RecyclerView android:id="@+id/scriptRecyclerView" android:layout_width="match_parent"
                android:layout_height="0dp" android:layout_weight="1" android:padding="8dp"/>
        </LinearLayout>

        <View android:id="@+id/eyeStrainOverlay" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="#26FFA500" android:visibility="gone" android:clickable="false" android:focusable="false" />

    </FrameLayout>

    <!-- Bottom Navigation -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
        android:orientation="horizontal" android:background="#1e293b" android:elevation="8dp">
        <TextView android:id="@+id/navFileExplorer" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="📁\nExplorer" android:textColor="#f8fafc" android:textSize="12sp" android:background="?android:attr/selectableItemBackground" />
        <TextView android:id="@+id/navJsEngine" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:text="⚡\nEngine" android:textColor="#64748b" android:textSize="12sp" android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

</LinearLayout>
